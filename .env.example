# ---------------------------------------------------------------------------
# CALLSCORE environment variables
# Copy to .env.local. Never commit real keys.
# ---------------------------------------------------------------------------

# Supabase project (Settings → API). Leave both empty to run in Demo Mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-only: used for settlement, AI forecasts, XP and
# admin writes. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional CoinGecko demo/pro API key. The public endpoint works without one
# (rate-limited). Ignored in Demo Mode, which uses a deterministic simulator.
MARKET_DATA_API_KEY=

# Comma-separated emails granted admin access in addition to profiles.is_admin.
ADMIN_EMAILS=

# Shared secret for the scheduled settlement route (/api/cron/settle).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Set to false to stop the scheduler from auto-creating the daily BTC/ETH/SOL Rounds.
AUTO_SCHEDULE_BATTLES=true
# Hour (UTC, 1-23) at which the auto-scheduled Daily Round locks. Opens 00:00, settles 00:00 next day.
DAILY_LOCK_HOUR_UTC=20

# Public URL used for absolute links, share links and Open Graph images.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# X (Twitter) handle shown in the header and footer links (without @).
NEXT_PUBLIC_X_HANDLE=Signal__Arena

# Season framing (optional). Season 0 = preview season. Founding Caller badge
# is awarded to forecasts locked within the founding window.
NEXT_PUBLIC_SEASON_NUMBER=0
NEXT_PUBLIC_SEASON_START=
NEXT_PUBLIC_SEASON_DAYS=30
NEXT_PUBLIC_SEASON_FOUNDING_DAYS=7

# Force Demo Mode (seeded data, simulated prices, cookie-based demo sign-in).
# Demo Mode is also activated automatically when Supabase credentials are absent.
NEXT_PUBLIC_DEMO_MODE=true
