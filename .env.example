# Supabase (leave blank to run in Demo Mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations (leave blank to disable; the app falls back safely)
GITHUB_TOKEN=
WEBSITE_CHECK_SECRET=

# Comma-separated list of admin/moderator email addresses
ADMIN_EMAILS=

# Secret required by scheduled-job routes under /api/cron/*
CRON_SECRET=

# Public app URL used for absolute links, share URLs and Open Graph metadata.
# Optional on Vercel: the deployment hostname is detected automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Force Demo Mode (deterministic fictional data, no external services)
NEXT_PUBLIC_DEMO_MODE=true
